[
  {
    "name": "lone message passes",
    "events": [
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-alice", "displayName": "alice" }, "body": "hi", "timestamp": "2024-01-01T00:00:00Z" },
        "expect": { "action": "pass" }
      }
    ]
  },
  {
    "name": "rapid follow-up within 2s window is dropped",
    "events": [
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-alice", "displayName": "alice" }, "body": "first", "timestamp": "2024-01-01T00:00:00Z" },
        "expect": { "action": "pass" }
      },
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-alice", "displayName": "alice" }, "body": "second", "timestamp": "2024-01-01T00:00:01Z" },
        "expect": { "action": "drop", "reason": "slow-mode: alice must wait 2000ms between messages" }
      }
    ]
  },
  {
    "name": "follow-up after 2s+ is allowed",
    "events": [
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-alice", "displayName": "alice" }, "body": "first", "timestamp": "2024-01-01T00:00:00Z" },
        "expect": { "action": "pass" }
      },
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-alice", "displayName": "alice" }, "body": "second", "timestamp": "2024-01-01T00:00:03Z" },
        "expect": { "action": "pass" }
      }
    ]
  },
  {
    "name": "different users are tracked independently",
    "events": [
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-alice", "displayName": "alice" }, "body": "first", "timestamp": "2024-01-01T00:00:00Z" },
        "expect": { "action": "pass" }
      },
      {
        "filter": "chat.message.received",
        "payload": { "user": { "id": "u-bob", "displayName": "bob" }, "body": "first", "timestamp": "2024-01-01T00:00:01Z" },
        "expect": { "action": "pass" }
      }
    ]
  }
]
