[
  {
    "name": "static index.html is served from assets/",
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/index.html",
          "expect": { "status": 200 }
        }
      }
    ]
  },
  {
    "name": "directory request serves index.html",
    "events": [
      { "http": { "method": "GET", "path": "/", "expect": { "status": 200 } } }
    ]
  },
  {
    "name": "GET /api/messages returns empty list when chat history is empty",
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/api/messages",
          "expect": {
            "status": 200,
            "headers": { "Content-Type": "application/json" },
            "body": "{\"messages\":[]}"
          }
        }
      }
    ]
  },
  {
    "name": "GET /api/messages returns messages from owncast.chat.history()",
    "given": {
      "chatHistory": [
        {
          "id": "m1",
          "user": { "id": "u-alice", "displayName": "alice" },
          "body": "hello",
          "timestamp": "2024-01-01T00:00:00Z"
        },
        {
          "id": "m2",
          "user": { "id": "u-bob", "displayName": "bob" },
          "body": "world",
          "timestamp": "2024-01-01T00:00:01Z"
        }
      ]
    },
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/api/messages",
          "expect": {
            "status": 200,
            "body": "{\"messages\":[{\"id\":\"m1\",\"user\":{\"id\":\"u-alice\",\"displayName\":\"alice\",\"displayColor\":0},\"body\":\"hello\",\"timestamp\":\"2024-01-01T00:00:00Z\"},{\"id\":\"m2\",\"user\":{\"id\":\"u-bob\",\"displayName\":\"bob\",\"displayColor\":0},\"body\":\"world\",\"timestamp\":\"2024-01-01T00:00:01Z\"}]}"
          }
        }
      }
    ]
  },
  {
    "name": "streams complete viewer-visible chat to overlay subscribers",
    "events": [
      {
        "event": "chat.message.broadcast",
        "payload": {
          "id": "m-live",
          "type": "CHAT",
          "user": { "id": "u-alice", "displayName": "alice" },
          "senderName": "alice",
          "body": "<p>hello <strong>live</strong></p>",
          "timestamp": "2024-01-01T00:00:00Z"
        }
      },
      {
        "event": "chat.message.broadcast",
        "payload": {
          "id": "m-bot",
          "type": "CHAT",
          "user": { "displayName": "helper", "isBot": true },
          "senderName": "helper",
          "body": "<p>response</p>",
          "timestamp": "2024-01-01T00:00:01Z"
        }
      }
    ],
    "expect": {
      "sseSends": [
        {
          "channel": "overlay",
          "event": "chat",
          "data": "{\"body\": \"<p>hello <strong>live</strong></p>\", \"id\": \"m-live\", \"senderName\": \"alice\", \"timestamp\": \"2024-01-01T00:00:00Z\", \"type\": \"CHAT\", \"user\": {\"displayName\": \"alice\", \"id\": \"u-alice\"}}"
        },
        {
          "channel": "overlay",
          "event": "chat",
          "data": "{\"body\": \"<p>response</p>\", \"id\": \"m-bot\", \"senderName\": \"helper\", \"timestamp\": \"2024-01-01T00:00:01Z\", \"type\": \"CHAT\", \"user\": {\"displayName\": \"helper\", \"isBot\": true}}"
        }
      ]
    }
  },
  {
    "name": "unknown API path returns 404",
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/api/nope",
          "expect": { "status": 404 }
        }
      }
    ]
  },
  {
    "name": "path traversal attempt is rejected",
    "events": [
      {
        "http": {
          "method": "GET",
          "path": "/../../../etc/passwd",
          "expect": { "status": 404 }
        }
      }
    ]
  }
]
