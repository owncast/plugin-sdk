[
  {
    "name": "greets users whose message starts with hi",
    "events": [
      {
        "event": "chat.message.received",
        "payload": { "id": "1", "user": { "id": "u1", "displayName": "alice" }, "body": "hi everyone", "timestamp": "2024-01-01T00:00:00Z" }
      }
    ],
    "expect": {
      "chatSends": ["hello, alice!"]
    }
  },
  {
    "name": "leaves other messages alone",
    "events": [
      {
        "event": "chat.message.received",
        "payload": { "id": "2", "user": { "id": "u2", "displayName": "bob" }, "body": "good morning", "timestamp": "2024-01-01T00:00:01Z" }
      }
    ],
    "expect": {
      "chatSends": []
    }
  }
]
